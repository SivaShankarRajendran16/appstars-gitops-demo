FROM python:3.11-slim
RUN apt-get update && apt-get install -y gcc curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Vendor the solc binary (downloaded once on a machine with internet access,
# committed to the repo under backend/vendor/) so the build and runtime
# never need to reach solc-bin.ethereum.org.
COPY vendor/solc-v0.8.20 /root/.solcx/solc-v0.8.20
RUN chmod +x /root/.solcx/solc-v0.8.20

COPY . .
EXPOSE 8000
ENTRYPOINT ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
